# Copy this file to .env and fill in real values. .env itself is gitignored.

# Point at your local full dataset once downloaded, e.g. /Users/you/Downloads/indian_court_judgments
LMAI_RAW_PDF_DIR=./data/sample_pdfs

# SQLite DB path (auto-created)
LMAI_DB_PATH=./data/legal_mind.db

# Retrieval API
LMAI_RETRIEVAL_HOST=0.0.0.0
LMAI_RETRIEVAL_PORT=5000

# Chatbot API (phase 2)
LMAI_CHATBOT_HOST=0.0.0.0
LMAI_CHATBOT_PORT=5001
ANTHROPIC_API_KEY=
